# Copy to .env and fill in your key. Never commit .env.
# app.py and play.py load .env automatically via python-dotenv.

# --- Option A: TypeSafe directly (default) ---
# Get a key at https://console.typesafe.ai/
TYPESAFE_API_KEY=ts-your-key-here
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest

# --- Option B: via OpenCode Zen/Console (uses your OpenCode API key) ---
# Get a key at https://opencode.ai/auth
# TYPESAFE_API_KEY=<your-opencode-console-key>
# TYPESAFE_BASE_URL=https://opencode.ai/zen
# Paid model ($0.042/1M input, output free):
# TYPESAFE_DEFAULT_MODEL=jev-1.13
# Free model (limited time):
# TYPESAFE_DEFAULT_MODEL=jev-1.13-free

# --- Web UI port (default 8000) ---
# PORT=8000
